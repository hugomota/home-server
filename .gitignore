# Ignore Node.js dependencies
node_modules/
npm-debug.log
yarn-error.log

# Ignore environment variables
.env
.env.local

# Ignore Docker-related files
docker-compose.override.yml
docker-compose.override.yaml
*.pid

# Ignore logs and temp files
logs/
*.log
*.swp

# Ignore application data and cache
data/
config/
cache/
!config/
config/*
!config/homepage/
!config/homepage/bookmarks.yaml
!config/homepage/docker.yaml
!config/homepage/services.yaml
!config/homepage/settings.yaml
!config/homepage/widgets.yaml

# Ignore media, photo libraries, backups, and downloads
media/
photos/icloud/
photos/library/
backups/
downloads/

# Ignore Let's Encrypt certificates
traefik/letsencrypt/
traefik/certs/

# Ignore IDE/editor config files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore system files
.DS_Store
Thumbs.db
