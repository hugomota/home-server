DOMAIN=local.server
PUID=1000
PGID=1000
TZ=Europe/Lisbon

CONFIG_ROOT=./config
DATA_ROOT=./data
# Big files live on the data disk (HDD, mounted at /srv/data).
DOWNLOADS_ROOT=/srv/data/downloads
MEDIA_ROOT=/srv/data/media
PHOTOS_ROOT=/srv/data/photos

# Immich: originals on the HDD; database, thumbnails and models stay on the SSD (DATA_ROOT).
UPLOAD_LOCATION=/srv/data/photos
DB_DATA_LOCATION=./data/immich/postgres
DB_USERNAME=postgres
# Letters and numbers only. Generate one with: openssl rand -hex 24
DB_PASSWORD=change-me
DB_DATABASE_NAME=immich
# "release" = always the newest; updated weekly by immich-update.timer.
IMMICH_VERSION=release



TRAEFIK_AUTH=admin:$$apr1$$replace-this$$replace-this-too

# Quarterly incremental photo backup to AWS S3 Glacier (scripts/photos-glacier-backup.sh)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_S3_BUCKET=your-glacier-backup-bucket
GLACIER_STORAGE_CLASS=DEEP_ARCHIVE
