DOMAIN=local.server
PUID=1000
PGID=1000
TZ=Europe/Lisbon

CONFIG_ROOT=./config
DATA_ROOT=./data
DOWNLOADS_ROOT=./downloads
MEDIA_ROOT=./media
PHOTOS_ROOT=./photos

UPLOAD_LOCATION=./photos/library
DB_DATA_LOCATION=./data/immich/postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE_NAME=immich
IMMICH_VERSION=release



TRAEFIK_AUTH=admin:$$apr1$$replace-this$$replace-this-too

# Quarterly incremental photo backup to AWS S3 Glacier (scripts/photos-glacier-backup.sh)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_S3_BUCKET=your-glacier-backup-bucket
GLACIER_STORAGE_CLASS=DEEP_ARCHIVE
