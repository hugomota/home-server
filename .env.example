DOMAIN=local.server
PUID=1000
PGID=1000
TZ=Europe/Lisbon

CONFIG_ROOT=./config
DATA_ROOT=./data
# Big files live on the data disk (HDD, mounted at /srv/data).
MEDIA_ROOT=/srv/data/media
# qBittorrent downloads go to media/downloads, next to movies/ and tv/, so imports are hardlinks.
PHOTOS_ROOT=/srv/data/photos

# Immich: originals on the HDD; database, thumbnails and models stay on the SSD (DATA_ROOT).
UPLOAD_LOCATION=/srv/data/photos
DB_DATA_LOCATION=./data/immich/postgres
DB_USERNAME=postgres
# Letters and numbers only. Generate one with: openssl rand -hex 24
DB_PASSWORD=change-me
DB_DATABASE_NAME=immich
# "release" = always the newest; updated weekly by immich-update.timer.
IMMICH_VERSION=release


# SearXNG (ai profile): overrides the secret_key in searxng/settings.yml.
# Generate one with: openssl rand -hex 32
SEARXNG_SECRET=change-me

# Quarterly incremental photo backup to AWS S3 Glacier (scripts/photos-glacier-backup.sh)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_S3_BUCKET=your-glacier-backup-bucket
GLACIER_STORAGE_CLASS=DEEP_ARCHIVE

# Open WebUI (ai profile): Claude API key from https://platform.claude.com/settings/keys
# (paid per use, separate from a Claude subscription). Leave empty to use only Ollama.
ANTHROPIC_API_KEY=
